# 本项目的服务配置已直接写在 docker-compose.yml 的 environment 段中，启动时无需 .env 文件。
# 此文件仅列出各服务读取的环境变量名，供需要定制时参考。
#
# 如需覆盖这些值，请在 docker-compose.yml 对应服务的 environment 段中修改；
# 或为服务添加 env_file: .env，并把下面的变量填进 .env（注意 .env 已被 .gitignore 排除）。

# ==================== Redis（gateway / strategy / validator / monitor）====================
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== vLLM 推理引擎（strategy / validator）====================
# 必须与 docker-compose.yml 中对应引擎的 --served-model-name 一致
VLLM_FP16_URL=http://vllm-fp16:8000/v1
VLLM_FP16_MODEL=qwen-fp16
VLLM_INT4_URL=http://vllm-int4:8000/v1
VLLM_INT4_MODEL=qwen-int4

# ==================== 模型权重 ====================
# 权重路径由 docker-compose.yml 的 --model 参数指定（挂载 ./models 进容器），
# 不在环境变量中配置：
#   FP16 引擎 → Qwen2-0.5B-Instruct
#   INT4 引擎 → Qwen2-0.5B-Instruct-GPTQ-Int4（GPTQ 量化，--quantization gptq）
# 下载方式见 DEPLOYMENT.md 步骤 1（ModelScope）。

# ==================== HuggingFace 镜像（可选）====================
HF_ENDPOINT=https://hf-mirror.com
