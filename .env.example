# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== vLLM 推理引擎 ====================
# FP16 高精度引擎（复杂任务）
VLLM_FP16_URL=http://vllm-fp16:8000/v1
VLLM_FP16_MODEL=qwen-fp16

# INT4 低精度量化引擎（简单任务，高吞吐）
VLLM_INT4_URL=http://vllm-int4:8000/v1
VLLM_INT4_MODEL=qwen-int4

# ==================== 模型配置 ====================
# FP16 模型（高精度）
MODEL_FP16=Qwen/Qwen2-0.5B-Instruct
# INT4 模型（AWQ 量化，低显存）
MODEL_INT4=Qwen/Qwen2-0.5B-Instruct-AWQ

# HuggingFace 镜像（国内网络建议开启）
HF_ENDPOINT=https://hf-mirror.com
